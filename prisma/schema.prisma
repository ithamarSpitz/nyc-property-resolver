generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyResolutionInputType {
  ADDRESS
  BBL
}

enum Dataset {
  DOB_ECB_VIOLATIONS
}

enum CoverageStatus {
  CHECKED
  NOT_CHECKED
  FAILED
}

enum CoverageStatusReason {
  NEVER_INGESTED
  NO_VALID_BIN
  IDENTIFIERS_CHANGED
  IDENTIFIERS_CHANGED_AFTER_SNAPSHOT
}

enum IngestionRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SOURCE_CHANGED
}

enum IngestionTriggerType {
  SCHEDULED
  MANUAL
}

enum IngestionBatchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model Property {
  id                String   @id @default(uuid()) @db.Uuid
  identifierVersion Int      @default(1) @map("identifier_version")
  bbl               String   @unique @db.VarChar(10)
  condoBaseBbl      String?  @map("condo_base_bbl") @db.VarChar(10)
  condoBillingBbl   String?  @map("condo_billing_bbl") @db.VarChar(10)
  normalizedAddress String?  @map("normalized_address")
  borough           Int
  block             Int
  lot               Int
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime @map("resolved_at") @db.Timestamptz(6)

  resolutionInputs   PropertyResolutionInput[]
  bins               PropertyBin[]
  datasetCoverage    PropertyDatasetCoverage[]
  ingestionSnapshots IngestionRunPropertyBin[]

  @@map("properties")
}

model PropertyResolutionInput {
  id                 String                      @id @default(uuid()) @db.Uuid
  inputType          PropertyResolutionInputType @map("input_type")
  normalizedInput    String                      @map("normalized_input")
  propertyId         String                      @map("property_id") @db.Uuid
  resolvedAt         DateTime                    @map("resolved_at") @db.Timestamptz(6)
  resolverConfidence Float?                      @map("resolver_confidence")
  resolverMetadata   Json?                       @map("resolver_metadata")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([inputType, normalizedInput])
  @@map("property_resolution_inputs")
}

model PropertyBin {
  propertyId String @map("property_id") @db.Uuid
  bin        String @db.VarChar(7)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, bin])
  @@index([bin])
  @@map("property_bins")
}

model PropertyDatasetCoverage {
  propertyId        String                @map("property_id") @db.Uuid
  dataset           Dataset
  status            CoverageStatus
  statusReason      CoverageStatusReason? @map("status_reason")
  lastAttemptRunId  String?               @map("last_attempt_run_id") @db.Uuid
  lastSuccessRunId  String?               @map("last_success_run_id") @db.Uuid
  lastAttemptAt     DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  lastSuccessAt     DateTime?             @map("last_success_at") @db.Timestamptz(6)
  sourceWatermarkAt DateTime?             @map("source_watermark_at") @db.Timestamptz(6)
  lastError         String?               @map("last_error")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, dataset])
  @@map("property_dataset_coverage")
}

model IngestionRun {
  id                       String               @id @default(uuid()) @db.Uuid
  dataset                  Dataset
  status                   IngestionRunStatus   @default(QUEUED)
  triggerType              IngestionTriggerType @map("trigger_type")
  initializationComplete   Boolean              @default(false) @map("initialization_complete")
  expectedPropertyBinCount Int?                 @map("expected_property_bin_count")
  expectedBinCount         Int?                 @map("expected_bin_count")
  expectedBatchCount       Int?                 @map("expected_batch_count")
  failureStage             String?              @map("failure_stage")
  lastError                String?              @map("last_error")
  startedAt                DateTime?            @map("started_at") @db.Timestamptz(6)
  finishedAt               DateTime?            @map("finished_at") @db.Timestamptz(6)
  sourceWatermarkAtStart   DateTime?            @map("source_watermark_at_start") @db.Timestamptz(6)
  sourceWatermarkAtEnd     DateTime?            @map("source_watermark_at_end") @db.Timestamptz(6)
  binsScanned              Int                  @default(0) @map("bins_scanned")
  dataPageCalls            Int                  @default(0) @map("data_page_calls")
  metadataCalls            Int                  @default(0) @map("metadata_calls")
  retryCalls               Int                  @default(0) @map("retry_calls")
  totalSocrataCalls        Int                  @default(0) @map("total_socrata_calls")
  rowsFetched              Int                  @default(0) @map("rows_fetched")
  rowsWritten              Int                  @default(0) @map("rows_written")
  failures                 Int                  @default(0)

  propertyBinSnapshot IngestionRunPropertyBin[]
  batches             IngestionBatch[]
  rawRows             EcbViolationRaw[]
  stagingRows         EcbViolationStaging[]
  liveRows            EcbViolation[]

  @@index([dataset, status])
  @@map("ingestion_runs")
}

model IngestionRunPropertyBin {
  runId                     String @map("run_id") @db.Uuid
  propertyId                String @map("property_id") @db.Uuid
  propertyIdentifierVersion Int    @map("property_identifier_version")
  bin                       String @db.VarChar(7)

  run      IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([runId, propertyId, bin])
  @@index([runId, bin])
  @@index([runId, propertyId])
  @@map("ingestion_run_property_bins")
}

model IngestionBatch {
  id              String               @id @default(uuid()) @db.Uuid
  runId           String               @map("run_id") @db.Uuid
  batchNumber     Int                  @map("batch_number")
  status          IngestionBatchStatus @default(PENDING)
  batchDefinition Json                 @map("batch_definition")
  pagesFetched    Int                  @default(0) @map("pages_fetched")
  attemptCount    Int                  @default(0) @map("attempt_count")
  rowsFetched     Int                  @default(0) @map("rows_fetched")
  lastError       String?              @map("last_error")
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)

  run IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, batchNumber])
  @@map("ingestion_batches")
}

model EcbViolationRaw {
  id                 String   @id @default(uuid()) @db.Uuid
  sourceId           String   @map("source_id")
  socrataRowId       String   @map("socrata_row_id")
  sourceRowUpdatedAt DateTime @map("source_row_updated_at") @db.Timestamptz(6)
  fetchedAt          DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  firstSeenRunId     String   @map("first_seen_run_id") @db.Uuid
  payload            Json

  firstSeenRun IngestionRun @relation(fields: [firstSeenRunId], references: [id], onDelete: Restrict)

  @@unique([sourceId, sourceRowUpdatedAt])
  @@index([sourceId])
  @@map("ecb_violation_raw")
}

model EcbViolationStaging {
  id                 String    @id @default(uuid()) @db.Uuid
  runId              String    @map("run_id") @db.Uuid
  sourceId           String    @map("source_id")
  socrataRowId       String    @map("socrata_row_id")
  bin                String    @db.VarChar(7)
  violationNumber    String?   @map("violation_number")
  issueDate          DateTime? @map("issue_date") @db.Date
  ecbViolationStatus String?   @map("ecb_violation_status")
  balanceDue         Decimal?  @map("balance_due") @db.Decimal(15, 2)
  sourceRowUpdatedAt DateTime  @map("source_row_updated_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  run IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceId])
  @@index([runId, bin])
  @@map("ecb_violation_staging")
}

model EcbViolation {
  id                 String    @id @default(uuid()) @db.Uuid
  sourceId           String    @unique @map("source_id")
  socrataRowId       String    @map("socrata_row_id")
  bin                String    @db.VarChar(7)
  violationNumber    String?   @map("violation_number")
  issueDate          DateTime? @map("issue_date") @db.Date
  ecbViolationStatus String?   @map("ecb_violation_status")
  balanceDue         Decimal?  @map("balance_due") @db.Decimal(15, 2)
  sourceRowUpdatedAt DateTime  @map("source_row_updated_at") @db.Timestamptz(6)
  lastSuccessRunId   String    @map("last_success_run_id") @db.Uuid
  isCurrent          Boolean   @default(true) @map("is_current")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lastSuccessRun IngestionRun @relation(fields: [lastSuccessRunId], references: [id], onDelete: Restrict)

  @@index([bin])
  @@map("ecb_violations")
}

# Normalize text files in Git; keep executable/script files LF for Docker/Linux worktrees.
* text=auto

*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.prisma text eol=lf
*.sql text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
evidence/**/*.log text eol=lf

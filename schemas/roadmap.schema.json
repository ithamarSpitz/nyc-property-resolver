{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap.schema.json",
  "title": "Agent Harness Roadmap",
  "type": "object",
  "required": [
    "sprints"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "sprints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "tasks"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "tasks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "stage": {
                  "type": "integer",
                  "minimum": 1
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "model_class": {
                  "type": "string"
                },
                "max_attempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "timeout_minutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "review": {
                  "type": "boolean"
                },
                "allow_protected": {
                  "type": "boolean"
                },
                "allowed_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "verification": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "context": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "environment": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "docker",
                    null
                  ]
                },
                "review_model_class": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "stage_verification": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

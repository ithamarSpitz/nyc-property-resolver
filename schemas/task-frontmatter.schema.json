{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-frontmatter.schema.json",
  "title": "Agent Harness Task Frontmatter",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "integer",
      "minimum": 1
    },
    "model_class": {
      "type": "string",
      "minLength": 1
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    },
    "timeout_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "review": {
      "type": "boolean"
    },
    "allow_protected": {
      "type": "boolean"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "docker",
        null
      ]
    },
    "review_model_class": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}

{
  "name": "nyc-property-resolver",
  "version": "0.1.0",
  "private": true,
  "description": "NYC property resolution and ECB violation ingestion service",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:property-resolution": "node scripts/verify-property-resolution.mjs",
    "verify:ingestion-lifecycle": "node scripts/verify-ingestion-lifecycle.mjs",
    "verify:ingestion-publication": "node scripts/verify-ingestion-publication.mjs",
    "verify:ecb-source-contract": "npm run build && node dist/cli/verify-ecb-source-contract.js",
    "verify:api-operations": "node scripts/verify-api-operations.mjs",
    "acceptance:small": "node scripts/acceptance/small-acceptance.mjs",
    "acceptance:small:check": "node scripts/acceptance/small-acceptance.mjs --check",
    "acceptance:small:validate": "node scripts/acceptance/validate-small-evidence.mjs",
    "acceptance:small:validate-evidence": "node scripts/acceptance/validate-small-evidence.mjs",
    "acceptance:scale": "node scripts/acceptance/scale-10000.mjs",
    "acceptance:scale:validate-evidence": "node scripts/acceptance/validate-scale-evidence.mjs",
    "ingest:ecb": "node dist/cli/ingest-ecb.js",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/workers/ingestion.worker.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "bottleneck": "^2.19.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.16.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
